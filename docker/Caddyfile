# Caddy configuration of the production website (docker/Dockerfile.prod).
#
# One site serves everything:
#   /api/*, /sanctum/*, /up -> the Laravel API (PHP-FPM, FastCGI)
#   everything else         -> the built Vue app (index.html for unknown paths)
#
# Settings from the environment (compose.prod.yaml):
#   SITE_ADDRESS   the domain, e.g. askmydocs.example.com. "localhost" makes Caddy use its
#                  own local certificate authority instead of Let's Encrypt.
#   PHP_UPSTREAM   host:port of PHP-FPM.
#   HSTS           Strict-Transport-Security value; "max-age=0" for local testing, so the
#                  browser does not remember HTTPS-only for localhost.
#   TRUSTED_PROXIES  Space-separated CIDR ranges of a reverse proxy in front of this one
#                  (a server shared with another project). Only requests from there may set
#                  the visitor's IP address and HTTPS. Empty (default): nobody is trusted.
#
# Behind another proxy, SITE_ADDRESS is ":80": plain HTTP inside Docker, while the front
# proxy handles HTTPS and certificates.

{
	# The admin API is not needed (configuration only changes with a new image).
	admin off

	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# For every response (the API adds its own security headers).
	header {
		Strict-Transport-Security "{$HSTS:max-age=31536000}"
		# Do not reveal the server software; "Status" is a FastCGI header PHP-FPM sends.
		-Server
		-Via
		-Status
	}

	# --- Laravel API -------------------------------------------------------------
	@api path /api/* /sanctum/* /up
	handle @api {
		# PDFs up to 20 MB plus multipart overhead (Laravel validates the details).
		request_body {
			max_size 25MB
		}

		# Every API request runs public/index.php; Laravel reads the original path
		# from REQUEST_URI. Through FastCGI, Laravel also sees the visitor's real IP
		# address and HTTPS directly, so no proxy headers need to be trusted.
		rewrite * /index.php?{query}
		reverse_proxy {$PHP_UPSTREAM:app:9000} {
			transport fastcgi {
				root /app/public
				split .php
			}
		}
	}

	# --- Single-page app ---------------------------------------------------------
	handle {
		root * /srv

		header {
			# Only the app's own files. Styles need 'unsafe-inline': Vuetify adds its theme
			# as a <style> element and Vue binds inline style attributes. pdf.js runs in a
			# worker loaded from this site; images may use data: and blob: URLs.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}

		# Build files have a content hash in their name: cache them for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Everything else (index.html, favicon): always check for a newer version, so a
		# new release is picked up at once.
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# Vue Router paths (/documents, /conversations/...) are served by index.html.
		try_files {path} /index.html
		file_server
	}
}
